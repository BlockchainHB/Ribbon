---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
import '../styles/apps.css';
import '../styles/scenes.css';
interface Props { title?: string; description?: string; home?: boolean; }
const { title = 'Ribbon — Your agents, right beside your work.', description = 'Keep Codex beside your IDE, Claude beside your design tool, and your other windows in a scrolling workspace for Mac.', home = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social preview from tools/render-brand-assets.mjs. Crawlers need absolute URLs, so these follow PUBLIC_SITE_URL.
const socialImage = Astro.site ? new URL('/social/og.jpg', Astro.site).href : undefined;
const socialVideo = Astro.site ? new URL('/social/og.mp4', Astro.site).href : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#FFFFFF" /><meta name="description" content={description} /><meta name="color-scheme" content="light" /><title>{title}</title><link rel="icon" href="/favicon.ico" sizes="32x32" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />{canonical && <link rel="canonical" href={canonical} />}<meta property="og:type" content="website" /><meta property="og:site_name" content="Ribbon" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />{canonical && <meta property="og:url" content={canonical} />}{socialImage && <><meta property="og:image" content={socialImage} /><meta property="og:image:type" content="image/jpeg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Ribbon. Your agents, right beside your work: a scrolling workspace for your Mac." /><meta property="og:video" content={socialVideo} /><meta property="og:video:secure_url" content={socialVideo} /><meta property="og:video:type" content="video/mp4" /><meta property="og:video:width" content="1200" /><meta property="og:video:height" content="630" /><meta name="twitter:image" content={socialImage} /></>}<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />{!canonical && <meta name="robots" content="noindex, nofollow" />}<script is:inline defer data-website-id="dfid_ehqrdivRAtH90hN3Mv9a3" data-domain="ribbonwm.com" src="https://datafa.st/js/script.js"></script></head><body><a class="skip-link" href="#main">Skip to content</a><Header /><main id="main" class:list={{ 'document-main': !home }}><slot /></main><Footer /></body></html>
