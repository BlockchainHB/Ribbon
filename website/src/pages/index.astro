---
import Site from '../layouts/Site.astro';
import DownloadLink from '../components/DownloadLink.astro';
import WorkspaceScene from '../components/WorkspaceScene.astro';
import OverviewScene from '../components/OverviewScene.astro';
import Questions from '../components/Questions.astro';
---
<Site home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-intro"><h1 id="hero-title"><span class="desktop-example">Your agents,<br />right beside your work.</span><span class="mobile-example">Your agents,<br />right beside<br />your work.</span></h1><p class="hero-description"><span class="desktop-example">Codex beside your IDE. Claude beside your canvas.<br />A scrolling workspace for everything you’re working on.</span><span class="mobile-example">Codex beside your IDE.<br />Claude beside your canvas.<br />A scrolling workspace for your Mac.</span></p><div class="hero-actions"><span class="desktop-download"><DownloadLink icon /></span><a class="button mobile-download" href="#download">See download options</a><a class="text-link" href="#features">See how it works <span aria-hidden="true">→</span></a></div></div>
    <figure class="container hero-media" aria-label="Illustration of Codex, an IDE, and a browser preview in a scrolling workspace."><WorkspaceScene /><figcaption><span class="shortcut-caption">Move through your workspace <kbd>⌃ ⌥</kbd><kbd>← →</kbd></span></figcaption></figure>
  </section>
  <section id="features" class="container feature-section pair-feature"><div class="feature-copy"><h2>Keep the agent<br />beside the code.</h2><p><span class="desktop-example">Read the plan, review the changes, and check the result. Pair the windows you want to move together.</span><span class="mobile-example">Read the plan, review the changes, and pair the windows you want to move together.</span></p></div><figure aria-label="Illustration of an agent window paired with an IDE."><WorkspaceScene variant="coding" /></figure></section>
  <section class="container feature-section arrange-feature"><figure aria-label="Illustration of Ribbon’s icon-and-title overview with Codex, Claude, Terminal, and Cursor."><OverviewScene /></figure><div class="feature-copy"><h2>More agents.<br />One workspace.</h2><p><span class="desktop-example">Codex, Claude, another task. Find the window you need in the overview, then return to your work.</span><span class="mobile-example">Find the agent window you need in the overview, then return to your work.</span></p></div></section>
  <section class="container feature-section design-feature"><div class="feature-copy"><h2>Keep the idea<br />beside the canvas.</h2><p>Work through an idea with Claude while your design stays in view.</p></div><figure aria-label="Illustration of Claude beside a design canvas in Paper."><WorkspaceScene variant="design" /></figure></section>
  <section class="container displays-feature"><div class="display-copy"><h2>Your everyday<br />work, too.</h2><p>Notes beside your browser. Mail beside your calendar. <span class="desktop-example inline-example">A separate workspace on each display.</span><span class="mobile-example">A workspace on each display.</span></p></div><div class="display-scene"><img src="/assets/displays.svg" width="1080" height="406" alt="Illustration of separate workspaces on an external display and a MacBook." loading="lazy" /></div></section>
  <Questions />
  <section id="download" class="download-section container"><img src="/assets/ribbon-icon.png" width="88" height="88" alt="Ribbon" loading="lazy" /><h2><span class="desktop-example">Bring your workspace together.</span><span class="mobile-example">Get Ribbon<br />on your Mac.</span></h2><p class="mobile-example download-instructions">Open this page on your Mac<br />to download Ribbon.</p><div class="desktop-download"><DownloadLink /></div><button class="button mobile-download copy-link" type="button">Copy page link</button><span class="sr-only" aria-live="polite" id="copy-status"></span></section>
</Site>
<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-link');
  let reset: ReturnType<typeof setTimeout>;
  button?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status');
    try {
      await navigator.clipboard.writeText(window.location.href.split('#')[0]);
      button.textContent = 'Link copied';
      if (status) status.textContent = 'Page link copied to clipboard.';
      clearTimeout(reset);
      reset = setTimeout(() => { button.textContent = 'Copy page link'; }, 2000);
    } catch {
      if (status) status.textContent = 'Copy the page address from your browser to open it on your Mac.';
    }
  });
</script>
