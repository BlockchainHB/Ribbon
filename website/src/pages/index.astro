---
import Site from '../layouts/Site.astro';
import DownloadLink from '../components/DownloadLink.astro';
import WorkspaceScene from '../components/WorkspaceScene.astro';
import PairScene from '../components/PairScene.astro';
import OverviewScene from '../components/OverviewScene.astro';
import Questions from '../components/Questions.astro';
---
<Site home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-intro"><h1 id="hero-title">Your windows,<br />side by side.</h1><p class="hero-description">A scrolling window manager for your Mac.</p><div class="hero-actions"><span class="desktop-download"><DownloadLink icon /></span><a class="button mobile-download" href="#download">See download options</a><a class="text-link" href="#features">See how it works <span aria-hidden="true">→</span></a></div></div>
    <figure class="container hero-media"><WorkspaceScene /><figcaption><span class="shortcut-caption">Move between windows <kbd>⌃ ⌥</kbd><kbd>← →</kbd></span></figcaption></figure>
  </section>
  <section id="features" class="container feature-section pair-feature"><div class="feature-copy"><h2>Keep two apps<br />together.</h2><p>Keep your notes beside your browser, then move them as a pair.</p></div><PairScene /></section>
  <section class="container feature-section arrange-feature"><OverviewScene /><div class="feature-copy"><h2><span class="desktop-example">See it.<br />Move it.</span><span class="mobile-example">See it. Move it.</span></h2><p>See all your windows and drag them into the order you want.</p></div></section>
  <section class="container displays-feature"><div class="display-copy"><h2>More room.<br />On every screen.</h2><p>Keep a separate scrolling workspace on each display.</p></div><div class="display-scene"><img src="/assets/displays.svg" width="1080" height="406" alt="Illustration of separate workspaces on an external display and a MacBook." loading="lazy" /></div></section>
  <Questions />
  <section id="download" class="download-section container"><img src="/assets/ribbon-icon.png" width="88" height="88" alt="Ribbon" loading="lazy" /><h2><span class="desktop-example">Make it your workspace.</span><span class="mobile-example">Get Ribbon<br />on your Mac.</span></h2><p class="mobile-example download-instructions">Open this page on your Mac<br />to download the beta.</p><div class="desktop-download"><DownloadLink /></div><button class="button mobile-download copy-link" type="button">Copy page link</button><span class="sr-only" aria-live="polite" id="copy-status"></span></section>
</Site>
<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-link');
  let reset: ReturnType<typeof setTimeout>;
  button?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status');
    try {
      await navigator.clipboard.writeText(window.location.href.split('#')[0]);
      button.textContent = 'Link copied';
      if (status) status.textContent = 'Page link copied to clipboard.';
      clearTimeout(reset);
      reset = setTimeout(() => { button.textContent = 'Copy page link'; }, 2000);
    } catch {
      if (status) status.textContent = 'Copy the page address from your browser to open it on your Mac.';
    }
  });
</script>
