---
const apps = [{ id: 'codex', title: 'Codex' }, { id: 'claude', title: 'Claude' }, { id: 'terminal', title: 'Terminal' }, { id: 'cursor', title: 'Cursor' }];
---
<div class="overview-scene" aria-hidden="true">
  <div class="overview-panel">{apps.map((app) => <div class:list={['overview-item', { selected: app.id === 'claude' }]}><img src={`/assets/${app.id}.png`} alt="" width="80" height="80" loading="lazy" /><span>{app.title}</span></div>)}</div>
  <svg class="illustration-cursor" width="32" height="38" viewBox="0 0 32 38"><path d="M4 2L27 24L17 25L22 35L16 38L11 27L4 34Z" fill="#20242C" stroke="#FFFFFF" stroke-width="2" /></svg>
</div>
