---
import ClaudeWindow from './apps/ClaudeWindow.astro';
import CodexWindow from './apps/CodexWindow.astro';
import IdeWindow from './apps/IdeWindow.astro';
import TerminalWindow from './apps/TerminalWindow.astro';
import SceneToggle from './SceneToggle.astro';
const apps = [{ id: 'codex', title: 'Codex' }, { id: 'claude', title: 'Claude' }, { id: 'terminal', title: 'Terminal' }, { id: 'cursor', title: 'Cursor' }];
---
<div class="motion-scene" data-motion="overview">
  <div class="workspace-scene strip-scene overview-scene scene-light" aria-hidden="true">
    <div class="scene-viewport overview-workspace" data-viewport data-workspace>
      <div class="strip-track" data-track>
        <div class="strip-slot" data-slot="codex"><CodexWindow /></div>
        <div class="strip-slot" data-slot="ide"><IdeWindow /></div>
        <div class="strip-slot" data-slot="terminal"><TerminalWindow /></div>
        <div class="strip-slot" data-slot="claude"><ClaudeWindow variant="review" /></div>
      </div>
    </div>
    <div class="overview-panel" data-overview><span class="overview-highlight" data-highlight></span>{apps.map((app) => <div class="overview-item" data-item><img src={`/assets/${app.id}.png`} alt="" width="80" height="80" loading="lazy" /><span>{app.title}</span></div>)}</div>
    <svg class="illustration-cursor" data-pointer width="32" height="38" viewBox="0 0 32 38"><path d="M4 2L27 24L17 25L22 35L16 38L11 27L4 34Z" fill="#20242C" stroke="#FFFFFF" stroke-width="2" /></svg>
  </div>
  <SceneToggle label="overview demonstration" />
</div>
