---
import AgentWindow from './AgentWindow.astro';
import EditorWindow from './EditorWindow.astro';
import PreviewWindow from './PreviewWindow.astro';
import DesignWindow from './DesignWindow.astro';
interface Props { variant?: 'hero' | 'coding' | 'design'; }
const { variant = 'hero' } = Astro.props;
---
<div class:list={['workspace-scene', variant === 'hero' ? 'hero-stage' : 'pair-scene', { 'design-scene': variant === 'design' }]} aria-hidden="true">
  <AgentWindow design={variant === 'design'} />
  {variant === 'design' ? <DesignWindow /> : <EditorWindow />}
  {variant === 'hero' && <><PreviewWindow /><AgentWindow continuation /></>}
</div>
