---
import ClaudeWindow from './apps/ClaudeWindow.astro';
import CodexWindow from './apps/CodexWindow.astro';
import IdeWindow from './apps/IdeWindow.astro';
import SafariWindow from './apps/SafariWindow.astro';
import SceneToggle from './SceneToggle.astro';
import '../styles/hero.css';
---
<div class="motion-demo" data-motion="workspace">
  <div class="workspace-scene hero-stage" aria-hidden="true">
    <div class="scene-viewport" data-viewport>
      <div class="hero-track" data-track>
        <div class="hero-slot hero-agent"><CodexWindow /></div>
        <div class="hero-slot hero-editor" data-editor><IdeWindow compact /></div>
        <div class="hero-slot hero-preview" data-preview><SafariWindow /></div>
        <div class="hero-slot hero-companion" data-companion><ClaudeWindow variant="review" /></div>
        <div class="hero-group-outline" data-group-outline></div>
      </div>
    </div>
  </div>
  <div class="hero-demo-captions" aria-hidden="true">
    <span data-caption="swipe">Swipe through your workspace</span>
    <span data-caption="group">Move windows together</span>
    <span data-caption="stack">Stack windows in one column</span>
  </div>
  <SceneToggle label="workspace demonstration" class="hero-toggle" />
</div>
