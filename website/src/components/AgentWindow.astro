---
import WindowChrome from './WindowChrome.astro';
interface Props { design?: boolean; continuation?: boolean; }
const { design = false, continuation = false } = Astro.props;
---
<div class="example-window agent-window">
  <WindowChrome title={design || continuation ? 'Claude' : 'Codex'} />
  <div class="agent-content">
    <p class="agent-task desktop-example">{design ? 'A little more breathing room' : continuation ? 'Explore the next idea' : 'Build the new homepage'}</p>
    <p class="agent-task mobile-example">{design ? <>A little more<br />breathing room</> : <>Build the<br />homepage</>}</p>
    <p class="agent-prompt desktop-example">{design ? 'Make the homepage feel lighter.' : 'Keep the layout simple. Make the work the focus.'}</p>
    <p class="agent-reply desktop-example">{design ? 'Let’s simplify the layout and give the headline more room.' : 'I’ll update the hero and check the browser.'}</p>
    <p class="agent-reply mobile-example">{design ? 'Let’s simplify the layout and give the headline more room.' : <>Keep it simple.<br />I’ll check the browser next.</>}</p>
    {!design && <p class="agent-status">Editing index.astro</p>}
  </div>
</div>
