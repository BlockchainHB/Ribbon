---
import { links, releaseTag } from '../lib/release';
interface Props { compact?: boolean; icon?: boolean; }
const { compact = false, icon = false } = Astro.props;
// DataFast goal: each placement uses a distinct style, so it identifies the button.
const location = compact ? 'header' : icon ? 'hero' : 'download_section';
---
<a class:list={['button', { 'button-small': compact }]} href={links.download} aria-disabled={!links.download ? 'true' : undefined} data-fast-goal="download_click" data-fast-goal-location={location} data-fast-goal-version={releaseTag}>
  {icon && <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
  Download
</a>
