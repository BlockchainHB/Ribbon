---
import { links } from '../lib/release';
interface Props { compact?: boolean; icon?: boolean; }
const { compact = false, icon = false } = Astro.props;
---
<a class:list={['button', { 'button-small': compact }]} href={links.download} aria-disabled={!links.download ? 'true' : undefined}>
  {icon && <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
  Download
</a>
