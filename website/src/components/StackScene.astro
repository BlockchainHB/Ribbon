---
import CodexWindow from './apps/CodexWindow.astro';
import SafariWindow from './apps/SafariWindow.astro';
import TerminalWindow from './apps/TerminalWindow.astro';
import SceneToggle from './SceneToggle.astro';
---
<div class="motion-scene" data-motion="stack">
  <div class="workspace-scene strip-scene stack-scene scene-blue" aria-hidden="true">
    <div class="scene-viewport" data-viewport>
      <div class="strip-track">
        <div class="strip-slot" data-slot="codex"><CodexWindow /></div>
        <div class="strip-slot" data-slot="browser"><SafariWindow /></div>
        <div class="strip-slot" data-slot="terminal"><TerminalWindow /></div>
      </div>
    </div>
  </div>
  <SceneToggle label="stacking demonstration" />
</div>
