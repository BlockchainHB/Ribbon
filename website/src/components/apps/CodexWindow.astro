---
import AppWindow from './AppWindow.astro';
---
<AppWindow app="codex" title="Build the new homepage" icon="codex">
  <div class="agent-thread">
    <p class="thread-meta"><span>ribbon</span><span class="branch-chip"><svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v3a3 3 0 0 1-3 3H5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>main</span></p>
    <p class="chat-bubble">Keep the layout simple. Make the work the focus.</p>
    <p class="codex-step"><svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h5l3 3v9H4z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>Read <code>index.astro</code></p>
    <p class="diff-card"><span class="diff-file">Edited <code>index.astro</code></span><span class="diff-add">+3</span><span class="diff-remove">−2</span></p>
    <p class="agent-reply">Updated the hero. Checking the browser next.</p>
  </div>
  <div class="composer"><span>Ask Codex anything</span><span class="send-button"><svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></div>
</AppWindow>
